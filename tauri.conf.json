{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Witcher 3 Missables Tracker",
  "version": "1.3.1",
  "identifier": "dev.w3missables.tracker",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Witcher 3 · Missables Tracker",
        "width": 480,
        "height": 820,
        "minWidth": 360,
        "minHeight": 420,
        "x": 40,
        "y": 40,
        "alwaysOnTop": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
